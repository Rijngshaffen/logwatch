{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogWatch alert v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alert_id", "timestamp", "host", "category", "severity", "score", "detector", "reasons", "event", "baseline"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "alert_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "format": "date-time"},
    "host": {"type": "string"},
    "category": {"const": "log_anomaly"},
    "severity": {"enum": ["medium", "high", "critical"]},
    "score": {"type": "integer", "minimum": 1, "maximum": 100},
    "detector": {"const": "adaptive-statistical-v1"},
    "reasons": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["type"],
        "properties": {"type": {"enum": ["kernel_failure", "resource_exhaustion", "storage_failure", "authentication_failure", "error_severity", "novel_template", "volume_spike", "error_rate_spike"]}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "source", "service", "message", "level", "raw"],
      "properties": {
        "timestamp": {"type": "string"},
        "source": {"type": "string"},
        "service": {"type": "string"},
        "message": {"type": "string"},
        "level": {"enum": ["debug", "info", "warning", "error", "critical"]},
        "raw": {"type": "string"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "alerts", "suppressed", "templates", "ready", "warmup_events", "baseline_windows"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "alerts": {"type": "integer", "minimum": 1},
        "suppressed": {"type": "integer", "minimum": 0},
        "templates": {"type": "integer", "minimum": 0},
        "ready": {"type": "boolean"},
        "warmup_events": {"type": "integer", "minimum": 1},
        "baseline_windows": {"type": "integer", "minimum": 0}
      }
    }
  }
}
